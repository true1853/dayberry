generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  city         String        @default("Москва")
  bio          String        @default("")
  wants        String        @default("")
  avatar       String?       @default("")
  notifyPush   Boolean       @default(true)
  notifyEmail  Boolean       @default(true)
  notifyDeals  Boolean       @default(true)
  passwordHash String
  rating       Float         @default(0)
  reviewsCount Int           @default(0)
  dealsCount   Int           @default(0)
  balance      Int           @default(0)
  createdAt    DateTime      @default(now())
  lots         Lot[]
  reviewsGiven Review[]      @relation("reviewAuthor")
  reviewsGot   Review[]      @relation("reviewTarget")
  deals        Deal[]        @relation("dealInitiator")
  chatsOwned   Chat[]        @relation("chatOwner")
  chatsWith    Chat[]        @relation("chatPartner")
  sentMessages Message[]     @relation("messageFrom")
  transactions Transaction[]
  favorites    Favorite[]
  chatMemberships ChatMember[]
  notifications   Notification[]
  pushSubs        PushSubscription[]
  chainSteps      ChainStep[]   @relation("chainGiver")
  chainStepsTo    ChainStep[]   @relation("chainReceiver")
  chainsStarted   Chain[]       @relation("chainInitiator")

  @@index([email])
  @@index([city])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lotId])
  @@index([userId, createdAt])
}

model AiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  model     String
  payload   String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("reviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  rating    Int
  text      String
  createdAt DateTime @default(now())

  // один отзыв на сделку от каждого участника
  @@unique([dealId, authorId])
  @@index([targetId, createdAt])
}

model Lot {
  id              String     @id @default(cuid())
  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerKey        String     @default("me")
  kind            String     @default("item")
  cat             String
  title           String
  desc            String     @default("")
  wants           String     @default("")
  value           Int
  aiLow           Int
  aiHigh          Int
  valuationSource String     @default("manual") // 'ai' | 'manual'
  condition       String     @default("Новое или Б/У")
  photo           String     @default("")
  photoUrl        String?    @default("")
  views           Int        @default(0)
  hot             Boolean    @default(false)
  posted          String     @default("только что")
  status          String     @default("active")
  // не используется: задумывался как ручное закрепление, но выставлять его
  // некому. Колонку оставляем, чтобы db push не сносил данные на старте.
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  lotPhotos       LotPhoto[]
  favorites       Favorite[]
  deals           Deal[]     @relation("dealTarget")
  myDeals         Deal[]     @relation("dealMyLot")
  chainSteps      ChainStep[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
  @@index([cat])
  // основной запрос ленты: where status + order by createdAt
  @@index([status, createdAt])
  @@index([ownerId, status])
}

model LotPhoto {
  id    String @id @default(cuid())
  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  url   String
  label String @default("")
  order Int    @default(0)

  @@index([lotId, order])
}

model Deal {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation("dealInitiator", fields: [userId], references: [id], onDelete: Cascade)
  lotId              String
  lot                Lot      @relation("dealTarget", fields: [lotId], references: [id], onDelete: Cascade)
  myLotId            String?
  myLot              Lot?     @relation("dealMyLot", fields: [myLotId], references: [id], onDelete: SetNull)
  credits            Int      @default(0)
  stage              String   @default("created")
  status             String   @default("active")
  initiatorConfirmed Boolean  @default(false)
  partnerConfirmed   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  chat               Chat?
  reviews            Review[]

  @@index([status])
  @@index([userId])
  @@index([lotId])
  @@index([createdAt])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("earn")
  title     String
  sub       String   @default("")
  amt       Int      @default(0)
  status    String   @default("done")
  // На что ссылается операция. Сделки ищут свой эскроу по «последнему
  // held у пользователя»; в цепочке замороженных доплат сразу несколько,
  // и такой поиск разъезжается — поэтому ссылка явная.
  refType   String   @default("")
  refId     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([refType, refId])
}

// Чат бывает парным (direct) и групповым (chain). Состав участников живёт
// в ChatMember и для парного тоже — userId/partnerId остались только ради
// показа собеседника в существующих экранах и заполнены лишь у direct.
model Chat {
  id        String    @id @default(cuid())
  kind      String    @default("direct")
  userId    String?
  user      User?     @relation("chatOwner", fields: [userId], references: [id], onDelete: Cascade)
  partnerId String?
  partner   User?     @relation("chatPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  dealId    String?   @unique
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  chainId   String?   @unique
  chain     Chain?    @relation(fields: [chainId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  messages  Message[]
  members   ChatMember[]

  @@index([userId])
  @@index([partnerId])
  @@index([dealId])
  @@index([createdAt])
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  // до какого момента участник прочитал переписку; null — не открывал ни разу.
  // Счётчик непрочитанного живёт здесь, а не на Message: в групповом чате
  // цепочки одно и то же сообщение прочитано одним и не прочитано другим.
  lastReadAt DateTime?

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  fromId    String?
  from      User?    @relation("messageFrom", fields: [fromId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// Цепочка живёт по маршруту:
//   candidate — найдена движком, никого ещё не беспокоили
//   pending   — кто-то нажал «я в деле», остальным ушли уведомления, идёт TTL
//   active    — согласились все, лоты заблокированы, доплаты в эскроу
//   done      — все передачи подтверждены
//   failed | expired — отказ без замены | вышло время
//
// kind: circle — круг замкнут желанием (каждый получает вещь);
//       credit — круг замкнут баллами (последний вместо вещи платит).
model Chain {
  id          String      @id @default(cuid())
  kind        String      @default("circle")
  score       Int         @default(80)
  note        String      @default("")
  status      String      @default("candidate")
  city        String      @default("")
  // отпечаток состава: не даёт движку плодить дубли одной и той же цепочки
  fingerprint String      @unique
  initiatorId String?
  initiator   User?       @relation("chainInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)
  // цепочка, взамен которой собрана эта (авто-замена после отказа)
  replacesId  String?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  steps       ChainStep[]
  chat        Chat?

  @@index([status, score])
  @@index([status, expiresAt])
}

model ChainStep {
  id          String    @id @default(cuid())
  chainId     String
  chain       Chain     @relation(fields: [chainId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  userId      String
  user        User      @relation("chainGiver", fields: [userId], references: [id], onDelete: Cascade)
  // null — шаг закрытия баллами: участник ничего не отдаёт, только платит
  lotId       String?
  lot         Lot?      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("chainReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  value       Int       @default(0)
  // сколько баллов доплачивает участник; отрицательное — получает
  topup       Int       @default(0)
  // сила совпадения именно этого ребра, 0..100 — из неё считается score цепочки
  edgeScore   Int       @default(0)
  state       String    @default("pending")
  respondedAt DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?

  @@unique([chainId, userId])
  @@index([chainId, order])
  @@index([userId, state])
}

// Подписка браузера на web-push. У одного человека их столько, сколько
// устройств: телефон, рабочий ноутбук, планшет — каждое со своим endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String    @default("")
  entityType String    @default("")
  entityId   String    @default("")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
